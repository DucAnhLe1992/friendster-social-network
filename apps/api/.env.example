# Server
NODE_ENV=development
PORT=5000

# Database - the connection string from your Neon project (Dashboard -> Connect), e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/friendster?sslmode=require
# For a local database started with `npm run db:dev`, use the value below.
DATABASE_URL=postgresql://friendster:friendster@localhost:5432/friendster
# Optional direct connection for drizzle-kit and deployment migrations; defaults to DATABASE_URL.
DATABASE_URL_DIRECT=

# JWT (required in production: two different values, 32+ characters each)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS - the address(es) the web app is served from, comma-separated
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
