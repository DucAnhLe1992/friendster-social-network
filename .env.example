# Used by docker-compose.yml. Generate secrets with: openssl rand -hex 48

# Neon: the pooled connection string (host contains "-pooler") for the running API.
# Bundled Postgres (--profile local-db): postgresql://friendster:<POSTGRES_PASSWORD>@postgres:5432/friendster
DATABASE_URL=
# Neon: the direct (non-pooled) connection string, used only to run migrations. Defaults to DATABASE_URL.
DATABASE_URL_DIRECT=
# Only needed with --profile local-db
POSTGRES_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# The exact address people use to open the site (no trailing slash; omit :80 / :443)
CORS_ORIGIN=http://localhost
WEB_PORT=80
LOG_LEVEL=info
