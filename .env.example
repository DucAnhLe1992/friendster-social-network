# Used by docker-compose.yml and docker-compose.neon.yml. Generate secrets with: openssl rand -hex 48
# Set your Neon connection string for docker-compose.neon.yml; leave empty for bundled Postgres.
DATABASE_URL=
# Neon direct connection URL for migrations; required by docker-compose.neon.yml.
DATABASE_URL_DIRECT=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# The exact address people use to open the site (no trailing slash; omit :80 / :443)
CORS_ORIGIN=http://localhost
WEB_PORT=80
