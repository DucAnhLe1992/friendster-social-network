# Used by docker-compose.yml. Generate secrets with: openssl rand -hex 48
# Your Neon connection string. Leave empty to use the bundled local Postgres container instead.
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# The exact address people use to open the site (no trailing slash; omit :80 / :443)
CORS_ORIGIN=http://localhost
WEB_PORT=80
